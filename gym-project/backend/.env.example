

# Firebase Cloud Messaging (Fase 6) — service account JSON como string o ruta
FCM_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# ---- Correo (recuperación de contraseña) -------------------------------------
# Si SMTP_HOST queda vacío NO se envía nada: en desarrollo el código solo se
# imprime en la consola del backend. El .env se lee al ARRANCAR el servidor:
# después de editarlo, detenlo y vuelve a iniciarlo.
#
# Con Gmail:
#  1) Activa la verificación en 2 pasos en tu cuenta de Google.
#  2) Crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#  3) Pégala en SMTP_PASS (los espacios no importan). NO uses tu clave normal.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="Gym Admin <tu-correo@gmail.com>"
