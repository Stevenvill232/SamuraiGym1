# Copia este archivo a ".env" y ajusta los valores reales.
# NUNCA subas el archivo ".env" real a un repositorio (ya está en .gitignore).

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/gym_db?schema=public"

# Servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# CORS: orígenes permitidos separados por coma (la app admin corre en localhost
# durante desarrollo; en producción pon el dominio real)
CORS_ORIGINS="http://localhost:*"

# ---- IA (rutinas, alimentación y chat) ----------------------------------------
# La clave SOLO vive aquí: la app nunca la ve. Sin AI_API_KEY el asistente
# responde "no está configurado". Reinicia el servidor después de editar.
#   Anthropic (Claude): consigue la clave en https://console.anthropic.com
#   OpenAI:             consigue la clave en https://platform.openai.com
AI_PROVIDER=""          # anthropic | openai
AI_API_KEY=""
AI_MODEL=""     # con openai, por ejemplo: gpt-4o-mini
AI_MAX_POR_HORA=30               # límite de consultas por usuario por hora (control de costo)

# Firebase Cloud Messaging (Fase 6) — service account JSON como string o ruta
FCM_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# ---- Correo (recuperación de contraseña) -------------------------------------
# Si SMTP_HOST queda vacío NO se envía nada: en desarrollo el código solo se
# imprime en la consola del backend. El .env se lee al ARRANCAR el servidor:
# después de editarlo, detenlo y vuelve a iniciarlo.
#
# Con Gmail:
#  1) Activa la verificación en 2 pasos en tu cuenta de Google.
#  2) Crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#  3) Pégala en SMTP_PASS (los espacios no importan). NO uses tu clave normal.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="Gym Admin <tu-correo@gmail.com>"
